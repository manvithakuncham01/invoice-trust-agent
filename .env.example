# Copy to .env in the repository root. Run backend commands from backend/.
APP_ENV=local
DEMO_MODE=false
# Opaque session cookies; this secret is required for deployment configuration.
APP_SECRET=replace-with-a-random-value-of-at-least-32-characters
DATABASE_URL=sqlite:///./invoice_trust.db
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SESSION_TTL_MINUTES=60
COOKIE_SECURE=false
LLM_PROVIDER=fake
LLM_API_KEY=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
